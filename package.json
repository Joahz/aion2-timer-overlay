{
  "name": "aion2-timer-overlay",
  "version": "1.0.0",
  "description": "Floating, always-on-top Aion 2 event timer (rifts, world bosses, events)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "author": "Aion 2 Timer Overlay",
  "build": {
    "appId": "life.aion2.timeroverlay",
    "productName": "Aion 2 Timer Overlay",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Aion2TimerOverlay.exe"
    },
    "directories": {
      "output": "dist"
    }
  }
}